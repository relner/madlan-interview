# Copy to .env and fill in. Never commit .env.
PORT=3000
MONGO_URI=mongodb://mongo:27017/madlan
LOG_LEVEL=info

ANTHROPIC_API_KEY=
# Model is a deliberate choice (cost vs quality) — see WORK_PLAN.md section 8.4
# One model per task (see src/helpers/configuration.js). LLM_MODEL=... overrides both.
LLM_PARSE_MODEL=claude-sonnet-5-5
LLM_EXPLAIN_MODEL=claude-haiku-5-5
LLM_PARSE_TIMEOUT_MS=8000
LLM_EXPLAIN_TIMEOUT_MS=20000

# Cache lifetime for LLM answers (seconds). Data is static, so this can be long.
LLM_CACHE_TTL_SECONDS=604800

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
MESSAGE_MAX_LENGTH=500

# Minimum number of deals in a group before a trend may be described
MIN_SAMPLE_SIZE=5
